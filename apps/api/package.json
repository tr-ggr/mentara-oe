{
  "name": "@mentara-oe/api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prisma-generate"
        ],
        "outputs": [
          "{workspaceRoot}/apps/api/dist"
        ],
        "options": {
          "command": "rm -rf apps/api/dist && npx tsc --project apps/api/tsconfig.app.json"
        }
      },
      "prisma-generate": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/node_modules/.prisma/client"
        ],
        "options": {
          "cwd": "apps/api",
          "command": "npx prisma generate --schema prisma"
        }
      },
      "reset": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "npx prisma migrate reset --schema prisma"
        }
      },
      "prisma-migrate-dev": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/apps/api/prisma/migrations"
        ],
        "options": {
          "cwd": "apps/api",
          "command": "npx prisma migrate dev --schema prisma"
        }
      },
      "prisma-migrate-deploy": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "npx prisma migrate deploy --schema prisma"
        }
      },
      "bootstrap-admin": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/api/dist/scripts/bootstrap-admin.js"
        }
      },
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/api/dist/main.js"
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "openapi": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/api/dist/openapi.js"
        },
        "outputs": [
          "{workspaceRoot}/apps/api/openapi.json"
        ]
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "better-auth": "^1.3.4",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "prisma": "^7.5.0"
  }
}
